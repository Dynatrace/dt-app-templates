# Copy this file to `e2e/.env` and fill in the values before running the tests locally.
# The same values are configured as secrets in the `e2e` GitHub environment for CI.

DT_APP_ENVIRONMENT_URL=
DT_APP_OAUTH_CLIENT_ID=
DT_APP_OAUTH_CLIENT_SECRET=
DT_APP_DISABLE_TELEMETRY=1

# Optional. Pins the dt-app version under test. Defaults to the newest released version.
# Must be an exact version - a dist-tag such as `latest` is rejected.
# DT_APP_VERSION=1.18.0

# Optional. Comma-separated TypeScript versions to test against.
# Defaults to 4.9.5,5.6.2,6.0.3,latest. Narrow it down to speed up local runs.
# TYPESCRIPT_VERSIONS=latest

# Optional. Overrides where the templates are read from. Defaults to `<repo root>/templates`.
# TEMPLATES_DIR=
